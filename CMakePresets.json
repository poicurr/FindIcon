{
  "version": 5,
  "cmakeMinimumRequired": { "major": 3, "minor": 24, "patch": 0 },
  "configurePresets": [
    {
      "name": "release",
      "displayName": "Release with pinned static dependencies",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "FINDICON_FETCH_DEPS": "ON"
      }
    },
    {
      "name": "test",
      "displayName": "Release and tests",
      "inherits": "release",
      "binaryDir": "${sourceDir}/build/test",
      "cacheVariables": { "FINDICON_BUILD_TESTS": "ON" }
    },
    {
      "name": "system",
      "displayName": "Release with installed dependencies",
      "inherits": "release",
      "binaryDir": "${sourceDir}/build/system",
      "cacheVariables": { "FINDICON_FETCH_DEPS": "OFF" }
    }
  ],
  "buildPresets": [
    { "name": "release", "configurePreset": "release", "configuration": "Release" },
    { "name": "test", "configurePreset": "test", "configuration": "Release" },
    { "name": "system", "configurePreset": "system", "configuration": "Release" }
  ],
  "testPresets": [
    { "name": "test", "configurePreset": "test", "configuration": "Release", "output": { "outputOnFailure": true } }
  ]
}
